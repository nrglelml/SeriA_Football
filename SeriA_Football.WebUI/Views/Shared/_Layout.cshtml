@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Serie A" : "Serie A")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap">


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="container-xl site-header__inner">
            <a class="brand" asp-controller="Standings" asp-action="Index">
                <span class="league-mark">SA</span>
                <span class="brand__text">
                    <strong>Serie A</strong>
                    <small>Italy · 2026/27</small>
                </span>
            </a>

            <nav class="main-nav" aria-label="Main">
                <a class="main-nav__link @Active("Standings")" asp-controller="Standing" asp-action="Index">Standings</a>
                <a class="main-nav__link @Active("Fixtures")" asp-controller="Fixture" asp-action="Index">Fixtures</a>
            </nav>

            <a class="sa-btn sa-btn--ghost sa-btn--sm" asp-area="Admin" asp-controller="Account" asp-action="Login">Admin</a>
        </div>
    </header>

    <main class="container-xl page">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-xl site-footer__inner">
            <span>Serie A Bootcamp Case · .NET 8</span>
            <span>Data served by SeriA_Football.API</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
