@model MatchDetailPageViewModel
@{
    ViewData["Title"] = "Match Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var en = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    var match = Model.Match;
    var homeBadge = TeamHelper.Get(match.HomeTeamName);
    var awayBadge = TeamHelper.Get(match.AwayTeamName);

    int hId = match.HomeTeamId, aId = match.AwayTeamId;
    var rows = new[]
    {
        (Label: "Goals",         Home: match.Goals.Count(g => g.TeamId == hId), Away: match.Goals.Count(g => g.TeamId == aId)),
        (Label: "Yellow cards",  Home: Model.YellowCards(hId),                  Away: Model.YellowCards(aId)),
        (Label: "Red cards",     Home: Model.RedCards(hId),                     Away: Model.RedCards(aId)),
        (Label: "Substitutions", Home: Model.Subs(hId),                         Away: Model.Subs(aId)),
    };
}


<body class="match-page">
    <!-- SVG sembolleri (tekrar kullanılan ikonlar) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="i-ball" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.4l3.4 2.5-1.3 4h-4.2l-1.3-4z" fill="currentColor" /><path d="M12 3v4.4M20.5 9.3l-5.1.6M17.4 19.4l-3.3-5.5M6.6 19.4l3.3-5.5M3.5 9.3l5.1.6" fill="none" stroke="currentColor" stroke-width="1.4" /></symbol>
        <symbol id="i-swap" viewBox="0 0 24 24"><path d="M7 4v14M3.5 7.5L7 4l3.5 3.5M17 20V6M13.5 16.5L17 20l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
        <symbol id="i-stadium" viewBox="0 0 24 24"><ellipse cx="12" cy="9" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3 9v6c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9" fill="none" stroke="currentColor" stroke-width="1.8" /></symbol>
        <symbol id="i-whistle" viewBox="0 0 24 24"><circle cx="9" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12.5 10.5L21 6v4l-5.5 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></symbol>
    </svg>

    <main class="match-shell container-xl" data-match>

        <!-- ===== Partial: _MatchHero ===== -->
        <header class="match-hero">
            <partial name="_MatchHero" model="Model" />
        </header>

        <div class="match-body">
            <div class="row g-4">

                <!-- ===== Sol kolon ===== -->
                <div class="col-lg-8">

                    <!-- Partial: _MatchTimeline -->
                    <partial name="_MatchTimeline" model="Model" />

                    <!-- Partial: _GoalsPanel  -->
                    <partial name="_GoalsPanel" model="Model" />
                    <!-- Partial: _CardsPanel -->
                    <partial name="_CardsPanel" model="Model" />

                    <!-- Partial: _SubstitutionsPanel -->
                    <partial name="_SubstitutionsPanel" model="Model" />
                </div>

                <!-- ===== Sağ kolon ===== -->
                <aside class="col-lg-4 side-col" aria-label="Match Summary">

                    <!-- Partial: _PeriodScoreCards -->
                    <partial name="_PeriodScoreCards" model="Model" />

                    <!-- Partial: _MatchStats -->
                    @if (Model.HasEvents)
                    {
                        <section class="panel" aria-labelledby="stats-title">
                            <div class="panel__head">
                                <h2 class="panel__title" id="stats-title">Match summary</h2>
                                <div class="stats-teams" aria-hidden="true">
                                    <span><span class="team-crest team-crest--xs" style="--crest-a:@homeBadge.Primary;--crest-b:@homeBadge.Secondary"></span>@match.HomeTeamName</span>
                                    <span>@match.AwayTeamName<span class="team-crest team-crest--xs" style="--crest-a:@awayBadge.Primary;--crest-b:@awayBadge.Secondary"></span></span>
                                </div>
                            </div>

                            <ul class="stat-list">
                                @foreach (var r in rows)
                                {
                                    int total = r.Home + r.Away;
                                    int homePct = total == 0 ? 50 : r.Home * 100 / total;
                                    <li class="stat-row">
                                        <div class="stat-row__values">
                                            <span class="stat-val @(r.Home > r.Away ? "is-lead" : "")">@r.Home</span>
                                            <span class="stat-row__label">@r.Label</span>
                                            <span class="stat-val stat-val--away @(r.Away > r.Home ? "is-lead" : "")">@r.Away</span>
                                        </div>
                                        <div class="stat-bar" aria-hidden="true">
                                            <span class="bar-home" style="--w:calc(@(homePct)% - 2px)"></span>
                                            <span class="bar-away" style="--w:calc(@(100 - homePct)% - 2px)"></span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </section>
                    }

                    <!-- Partial: _MatchInfoCard -->
                    <section class="panel" aria-labelledby="info-title">
                        <div class="panel__head"><h2 class="panel__title" id="info-title">Match info</h2></div>
                        <dl class="info-list">
                            <div><dt>League</dt><dd>Serie A</dd></div>
                            <div><dt>Season</dt><dd>2026/27</dd></div>
                            <div><dt>Matchweek</dt><dd>@match.Week</dd></div>
                            <div><dt>Stadium</dt><dd>@match.Stadium</dd></div>
                            <div><dt>Date</dt><dd>@match.MatchDate.ToString("d MMMM yyyy", en)</dd></div>
                            <div><dt>Kick-off</dt><dd>@match.MatchDate.ToString("HH:mm")</dd></div>
                            <div><dt>Status</dt><dd>@match.Status.ToDisplayName()</dd></div>
                        </dl>
                    </section>
                </aside>
            </div>
        </div>

    </main>

    <script>
        (() => {
            const chips = document.querySelectorAll('[data-event-filter]');
            const items = document.querySelectorAll('.timeline [data-type]');

            chips.forEach(chip => chip.addEventListener('click', () => {
                const f = chip.dataset.eventFilter;
                chips.forEach(c => c.setAttribute('aria-pressed', String(c === chip)));
                items.forEach(li => { li.hidden = f !== 'all' && li.dataset.type !== f; });
            }));

            // Şeritteki işarete tıklayınca listedeki olaya git ve vurgula
            document.querySelectorAll('[data-flow-ref]').forEach(marker =>
                marker.addEventListener('click', () => {
                    const target = document.getElementById(marker.dataset.flowRef);
                    if (!target) return;
                    if (target.hidden) document.querySelector('[data-event-filter="all"]')?.click();
                    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    target.classList.add('is-active');
                    setTimeout(() => target.classList.remove('is-active'), 1600);
                }));
        })();
    </script>
</body>



