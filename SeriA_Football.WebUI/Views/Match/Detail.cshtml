@model MatchDetailPageViewModel
@{
    ViewData["Title"] = "Match Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<body class="match-page">
    <!-- SVG sembolleri (tekrar kullanılan ikonlar) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="i-ball" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.4l3.4 2.5-1.3 4h-4.2l-1.3-4z" fill="currentColor" /><path d="M12 3v4.4M20.5 9.3l-5.1.6M17.4 19.4l-3.3-5.5M6.6 19.4l3.3-5.5M3.5 9.3l5.1.6" fill="none" stroke="currentColor" stroke-width="1.4" /></symbol>
        <symbol id="i-swap" viewBox="0 0 24 24"><path d="M7 4v14M3.5 7.5L7 4l3.5 3.5M17 20V6M13.5 16.5L17 20l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
        <symbol id="i-stadium" viewBox="0 0 24 24"><ellipse cx="12" cy="9" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3 9v6c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9" fill="none" stroke="currentColor" stroke-width="1.8" /></symbol>
        <symbol id="i-whistle" viewBox="0 0 24 24"><circle cx="9" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12.5 10.5L21 6v4l-5.5 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></symbol>
    </svg>

    <main class="match-shell container-xl" data-match>

        <!-- ===== Partial: _MatchHero ===== -->
        <header class="match-hero">
            <div class="hero-topbar">
                <ul class="comp-tags" aria-label="Müsabaka">
                    <li class="comp-tag comp-tag--league">Serie A</li>
                    <li class="comp-tag">2026/27</li>
                    <li class="comp-tag">Hafta 12</li>
                </ul>
                <span class="status-pill">Maç bitti</span>
            </div>

            <div class="scoreboard">
                <div class="sb-team sb-team--home">
                    <span class="team-crest team-crest--xl crest-milan" aria-hidden="true">MIL</span>
                    <div>
                        <span class="sb-team__role">Ev sahibi</span>
                        <h1 class="sb-team__name">Milan</h1>
                        <ul class="sb-scorers" aria-label="Milan golleri">
                            <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>Rafael Leão 14'</li>
                            <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>Olivier Giroud 41'</li>
                        </ul>
                    </div>
                </div>

                <div class="sb-score">
                    <p class="sb-score__value" aria-label="Skor: Milan 2, Roma 1">
                        <span>2</span><span class="sb-score__sep" aria-hidden="true"></span><span class="is-loser">1</span>
                    </p>
                    <p class="sb-score__ht">İlk yarı 2-0</p>
                </div>

                <div class="sb-team sb-team--away is-loser">
                    <span class="team-crest team-crest--xl crest-roma" aria-hidden="true">ROM</span>
                    <div>
                        <span class="sb-team__role">Deplasman</span>
                        <h2 class="sb-team__name">Roma</h2>
                        <ul class="sb-scorers" aria-label="Roma golleri">
                            <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>Tammy Abraham 72'</li>
                        </ul>
                    </div>
                </div>
            </div>

            <ul class="hero-facts">
                <li><svg aria-hidden="true"><use href="#i-calendar" /></svg>18 Kasım 2026</li>
                <li><svg aria-hidden="true"><use href="#i-clock" /></svg>22:45</li>
                <li><svg aria-hidden="true"><use href="#i-stadium" /></svg>San Siro</li>
                <li><svg aria-hidden="true"><use href="#i-whistle" /></svg><span>Hakem:</span> Daniele Orsato</li>
            </ul>

            <!-- Partial: _MatchFlowStrip -->
            <section class="flow-strip" aria-labelledby="flow-title">
                <div class="flow-head">
                    <h2 class="flow-title" id="flow-title">Maç akışı</h2>
                    <p class="flow-hint">Ayrıntısını görmek için bir olaya dokun</p>
                </div>
                <div class="flow-scroll">
                    <div class="flow-track">
                        <span class="flow-side-label flow-side-label--home"><span class="team-crest team-crest--xs crest-milan" aria-hidden="true">MIL</span></span>
                        <span class="flow-side-label flow-side-label--away"><span class="team-crest team-crest--xs crest-roma" aria-hidden="true">ROM</span></span>
                        <span class="flow-axis" aria-hidden="true"></span>
                        <span class="flow-half" aria-hidden="true"><span>Devre arası</span></span>
                        <span class="flow-tick" style="--x:calc(15 / 95 * 100%)">15'</span>
                        <span class="flow-tick" style="--x:calc(30 / 95 * 100%)">30'</span>
                        <span class="flow-tick" style="--x:calc(45 / 95 * 100%)">45'</span>
                        <span class="flow-tick" style="--x:calc(60 / 95 * 100%)">60'</span>
                        <span class="flow-tick" style="--x:calc(75 / 95 * 100%)">75'</span>
                        <span class="flow-tick" style="--x:calc(90 / 95 * 100%)">90'</span>

                        <button type="button" class="flow-marker flow-marker--home flow-marker--goal" style="--m:14" data-flow-ref="ev-14" aria-label="14. dakika, Milan golü, Rafael Leão" title="14' Gol: Rafael Leão"><span class="flow-marker__dot"><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg></span></button>
                        <button type="button" class="flow-marker flow-marker--away flow-marker--card" style="--m:27" data-flow-ref="ev-27" aria-label="27. dakika, sarı kart, Paulo Dybala" title="27' Sarı kart: Paulo Dybala"><span class="flow-marker__dot"><span class="i-card i-card--yellow"></span></span></button>
                        <button type="button" class="flow-marker flow-marker--home flow-marker--goal" style="--m:41" data-flow-ref="ev-41" aria-label="41. dakika, Milan golü, Olivier Giroud" title="41' Gol: Olivier Giroud"><span class="flow-marker__dot"><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg></span></button>
                        <button type="button" class="flow-marker flow-marker--away flow-marker--card" style="--m:54" data-flow-ref="ev-54" aria-label="54. dakika, sarı kart, Bryan Cristante" title="54' Sarı kart: Bryan Cristante"><span class="flow-marker__dot"><span class="i-card i-card--yellow"></span></span></button>
                        <button type="button" class="flow-marker flow-marker--away flow-marker--sub" style="--m:58" data-flow-ref="ev-58" aria-label="58. dakika, Roma oyuncu değişikliği" title="58' Değişiklik: Pellegrini girdi"><span class="flow-marker__dot"></span></button>
                        <button type="button" class="flow-marker flow-marker--home flow-marker--sub" style="--m:64" data-flow-ref="ev-64" aria-label="64. dakika, Milan oyuncu değişikliği" title="64' Değişiklik: Pulisic girdi"><span class="flow-marker__dot"></span></button>
                        <button type="button" class="flow-marker flow-marker--home flow-marker--card" style="--m:67" data-flow-ref="ev-67" aria-label="67. dakika, sarı kart, Fikayo Tomori" title="67' Sarı kart: Fikayo Tomori"><span class="flow-marker__dot"><span class="i-card i-card--yellow"></span></span></button>
                        <button type="button" class="flow-marker flow-marker--away flow-marker--goal" style="--m:72" data-flow-ref="ev-72" aria-label="72. dakika, Roma golü, Tammy Abraham" title="72' Gol: Tammy Abraham"><span class="flow-marker__dot"><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg></span></button>
                        <button type="button" class="flow-marker flow-marker--away flow-marker--card" style="--m:74;margin-left:7px" data-flow-ref="ev-74" aria-label="74. dakika, sarı kart, Gianluca Mancini" title="74' Sarı kart: Gianluca Mancini"><span class="flow-marker__dot"><span class="i-card i-card--yellow"></span></span></button>
                        <button type="button" class="flow-marker flow-marker--home flow-marker--sub" style="--m:78" data-flow-ref="ev-78" aria-label="78. dakika, Milan oyuncu değişikliği" title="78' Değişiklik: Musah girdi"><span class="flow-marker__dot"></span></button>
                        <button type="button" class="flow-marker flow-marker--away flow-marker--sub" style="--m:79" data-flow-ref="ev-79" aria-label="79. dakika, Roma oyuncu değişikliği" title="79' Değişiklik: Belotti girdi"><span class="flow-marker__dot"></span></button>
                        <button type="button" class="flow-marker flow-marker--home flow-marker--card" style="--m:83" data-flow-ref="ev-83" aria-label="83. dakika, sarı kart, Theo Hernández" title="83' Sarı kart: Theo Hernández"><span class="flow-marker__dot"><span class="i-card i-card--yellow"></span></span></button>
                        <button type="button" class="flow-marker flow-marker--home flow-marker--sub" style="--m:88" data-flow-ref="ev-88" aria-label="88. dakika, Milan oyuncu değişikliği" title="88' Değişiklik: Okafor girdi"><span class="flow-marker__dot"></span></button>
                        <button type="button" class="flow-marker flow-marker--away flow-marker--card" style="--m:92" data-flow-ref="ev-90" aria-label="90+2. dakika, kırmızı kart, Diego Llorente" title="90+2' Kırmızı kart: Diego Llorente"><span class="flow-marker__dot"><span class="i-card i-card--red"></span></span></button>
                    </div>
                </div>
            </section>
        </header>

        <div class="match-body">
            <div class="row g-4">

                <!-- ===== Sol kolon ===== -->
                <div class="col-lg-8">

                    <!-- Partial: _MatchTimeline -->
                    <section class="panel" aria-labelledby="timeline-title">
                        <div class="panel__head">
                            <h2 class="panel__title" id="timeline-title">Maç olayları</h2>
                            <div class="event-filter" role="group" aria-label="Olay türüne göre filtrele">
                                <button type="button" class="chip" data-event-filter="all" aria-pressed="true">Tümü</button>
                                <button type="button" class="chip" data-event-filter="goal" aria-pressed="false">Goller</button>
                                <button type="button" class="chip" data-event-filter="card" aria-pressed="false">Kartlar</button>
                                <button type="button" class="chip" data-event-filter="sub" aria-pressed="false">Değişiklikler</button>
                            </div>
                        </div>

                        <div class="timeline-legend" aria-hidden="true">
                            <span><span class="team-crest team-crest--xs crest-milan">MIL</span>Milan</span>
                            <span></span>
                            <span>Roma<span class="team-crest team-crest--xs crest-roma">ROM</span></span>
                        </div>

                     
                        <ol class="timeline">
                            <li class="event event--period"><span class="period-mark">Başlama düdüğü</span></li>

                            <li class="event event--home event--goal" id="ev-14" data-type="goal">
                                <span class="event__minute">14'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg></span>
                                    <span class="event-card__body"><span class="event-card__player">Rafael Leão</span><span class="event-card__meta">Gol, asist: Theo Hernández</span></span>
                                    <span class="event-score">1-0</span>
                                </div>
                            </li>

                            <li class="event event--away event--yellow" id="ev-27" data-type="card">
                                <span class="event__minute">27'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><span class="i-card i-card--yellow"></span></span>
                                    <span class="event-card__body"><span class="event-card__player">Paulo Dybala</span><span class="event-card__meta">Sarı kart, faul</span></span>
                                </div>
                            </li>

                            <li class="event event--home event--goal" id="ev-41" data-type="goal">
                                <span class="event__minute">41'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg></span>
                                    <span class="event-card__body"><span class="event-card__player">Olivier Giroud</span><span class="event-card__meta">Gol, kafa, asist: Rafael Leão</span></span>
                                    <span class="event-score">2-0</span>
                                </div>
                            </li>

                            <li class="event event--period"><span class="period-mark">Devre arası <strong>2-0</strong></span></li>

                            <li class="event event--away event--yellow" id="ev-54" data-type="card">
                                <span class="event__minute">54'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><span class="i-card i-card--yellow"></span></span>
                                    <span class="event-card__body"><span class="event-card__player">Bryan Cristante</span><span class="event-card__meta">Sarı kart, taktik faul</span></span>
                                </div>
                            </li>

                            <li class="event event--away event--sub" id="ev-58" data-type="sub">
                                <span class="event__minute">58'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><svg width="18" height="18" aria-hidden="true"><use href="#i-swap" /></svg></span>
                                    <span class="event-card__body"><span class="event-card__player sub-in">Lorenzo Pellegrini</span><span class="event-card__meta sub-out">Stephan El Shaarawy</span></span>
                                </div>
                            </li>

                            <li class="event event--home event--sub" id="ev-64" data-type="sub">
                                <span class="event__minute">64'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><svg width="18" height="18" aria-hidden="true"><use href="#i-swap" /></svg></span>
                                    <span class="event-card__body"><span class="event-card__player sub-in">Christian Pulisic</span><span class="event-card__meta sub-out">Samuel Chukwueze</span></span>
                                </div>
                            </li>

                            <li class="event event--home event--yellow" id="ev-67" data-type="card">
                                <span class="event__minute">67'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><span class="i-card i-card--yellow"></span></span>
                                    <span class="event-card__body"><span class="event-card__player">Fikayo Tomori</span><span class="event-card__meta">Sarı kart, faul</span></span>
                                </div>
                            </li>

                            <li class="event event--away event--goal" id="ev-72" data-type="goal">
                                <span class="event__minute">72'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg></span>
                                    <span class="event-card__body"><span class="event-card__player">Tammy Abraham</span><span class="event-card__meta">Gol, asist: Lorenzo Pellegrini</span></span>
                                    <span class="event-score">2-1</span>
                                </div>
                            </li>

                            <li class="event event--away event--yellow" id="ev-74" data-type="card">
                                <span class="event__minute">74'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><span class="i-card i-card--yellow"></span></span>
                                    <span class="event-card__body"><span class="event-card__player">Gianluca Mancini</span><span class="event-card__meta">Sarı kart, itiraz</span></span>
                                </div>
                            </li>

                            <li class="event event--home event--sub" id="ev-78" data-type="sub">
                                <span class="event__minute">78'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><svg width="18" height="18" aria-hidden="true"><use href="#i-swap" /></svg></span>
                                    <span class="event-card__body"><span class="event-card__player sub-in">Yunus Musah</span><span class="event-card__meta sub-out">Ruben Loftus-Cheek</span></span>
                                </div>
                            </li>

                            <li class="event event--away event--sub" id="ev-79" data-type="sub">
                                <span class="event__minute">79'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><svg width="18" height="18" aria-hidden="true"><use href="#i-swap" /></svg></span>
                                    <span class="event-card__body"><span class="event-card__player sub-in">Andrea Belotti</span><span class="event-card__meta sub-out">Tammy Abraham</span></span>
                                </div>
                            </li>

                            <li class="event event--home event--yellow" id="ev-83" data-type="card">
                                <span class="event__minute">83'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><span class="i-card i-card--yellow"></span></span>
                                    <span class="event-card__body"><span class="event-card__player">Theo Hernández</span><span class="event-card__meta">Sarı kart, oyunu geciktirme</span></span>
                                </div>
                            </li>

                            <li class="event event--home event--sub" id="ev-88" data-type="sub">
                                <span class="event__minute">88'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><svg width="18" height="18" aria-hidden="true"><use href="#i-swap" /></svg></span>
                                    <span class="event-card__body"><span class="event-card__player sub-in">Noah Okafor</span><span class="event-card__meta sub-out">Rafael Leão</span></span>
                                </div>
                            </li>

                            <li class="event event--away event--red" id="ev-90" data-type="card">
                                <span class="event__minute">90+2'</span>
                                <div class="event-card">
                                    <span class="event-card__icon"><span class="i-card i-card--red"></span></span>
                                    <span class="event-card__body"><span class="event-card__player">Diego Llorente</span><span class="event-card__meta">Kırmızı kart, gol şansını engelleme</span></span>
                                </div>
                            </li>

                            <li class="event event--period"><span class="period-mark">Maç sonu <strong>2-1</strong></span></li>
                        </ol>
                    </section>

                    <!-- Partial: _GoalsPanel + _CardsPanel -->
                    <section class="panel" aria-labelledby="goals-title">
                        <div class="panel__head"><h2 class="panel__title" id="goals-title">Goller</h2></div>
                        <div class="split">
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs crest-milan" aria-hidden="true">MIL</span>Milan<span class="split__count">2 gol</span></h3>
                                <ul class="item-list goal-list">
                                    <li><span class="item-minute">14'</span><span class="item-main"><strong>Rafael Leão</strong><small>Asist: Theo Hernández</small></span></li>
                                    <li><span class="item-minute">41'</span><span class="item-main"><strong>Olivier Giroud</strong><small>Asist: Rafael Leão</small></span></li>
                                </ul>
                            </div>
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs crest-roma" aria-hidden="true">ROM</span>Roma<span class="split__count">1 gol</span></h3>
                                <ul class="item-list goal-list">
                                    <li><span class="item-minute">72'</span><span class="item-main"><strong>Tammy Abraham</strong><small>Asist: Lorenzo Pellegrini</small></span></li>
                                </ul>
                            </div>
                        </div>
                    </section>

                    <section class="panel" aria-labelledby="cards-title">
                        <div class="panel__head"><h2 class="panel__title" id="cards-title">Kartlar</h2></div>
                        <div class="split">
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs crest-milan" aria-hidden="true">MIL</span>Milan<span class="split__count">2 kart</span></h3>
                                <ul class="item-list">
                                    <li><span class="item-minute">67'</span><span class="item-main"><strong>Fikayo Tomori</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                                    <li><span class="item-minute">83'</span><span class="item-main"><strong>Theo Hernández</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                                </ul>
                            </div>
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs crest-roma" aria-hidden="true">ROM</span>Roma<span class="split__count">4 kart</span></h3>
                                <ul class="item-list">
                                    <li><span class="item-minute">27'</span><span class="item-main"><strong>Paulo Dybala</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                                    <li><span class="item-minute">54'</span><span class="item-main"><strong>Bryan Cristante</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                                    <li><span class="item-minute">74'</span><span class="item-main"><strong>Gianluca Mancini</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                                    <li><span class="item-minute">90+2'</span><span class="item-main"><strong>Diego Llorente</strong></span><span class="card-tag"><span class="i-card i-card--red"></span>Kırmızı</span></li>
                                </ul>
                            </div>
                        </div>
                    </section>

                    <!-- Partial: _SubstitutionsPanel -->
                    <section class="panel" aria-labelledby="subs-title">
                        <div class="panel__head"><h2 class="panel__title" id="subs-title">Oyuncu değişiklikleri</h2></div>
                        <div class="split">
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs crest-milan" aria-hidden="true">MIL</span>Milan<span class="split__count">3 değişiklik</span></h3>
                                <ul class="item-list">
                                    <li><span class="item-minute">64'</span><span class="item-main"><strong class="sub-in">Christian Pulisic</strong><small class="sub-out">Samuel Chukwueze</small></span></li>
                                    <li><span class="item-minute">78'</span><span class="item-main"><strong class="sub-in">Yunus Musah</strong><small class="sub-out">Ruben Loftus-Cheek</small></span></li>
                                    <li><span class="item-minute">88'</span><span class="item-main"><strong class="sub-in">Noah Okafor</strong><small class="sub-out">Rafael Leão</small></span></li>
                                </ul>
                            </div>
                            <div class="split__col">
                                <h3 class="split__team"><span class="team-crest team-crest--xs crest-roma" aria-hidden="true">ROM</span>Roma<span class="split__count">2 değişiklik</span></h3>
                                <ul class="item-list">
                                    <li><span class="item-minute">58'</span><span class="item-main"><strong class="sub-in">Lorenzo Pellegrini</strong><small class="sub-out">Stephan El Shaarawy</small></span></li>
                                    <li><span class="item-minute">79'</span><span class="item-main"><strong class="sub-in">Andrea Belotti</strong><small class="sub-out">Tammy Abraham</small></span></li>
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- ===== Sağ kolon ===== -->
