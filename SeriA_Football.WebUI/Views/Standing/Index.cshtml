@model StandingPageViewModel
@{
    ViewData["Title"] = "Standings";
    int teamCount = Model.Standings.Count;
}

<div class="standings-shell" data-standings>

    @if (ViewBag.Error != null)
    {
        <div class="sa-alert sa-alert--error mb-3">@ViewBag.Error</div>
    }

    <!-- ===== Hero ===== -->
    <header class="standings-hero">
        <div class="hero-top">
            <div>
                <div class="hero-league"><span class="league-mark" aria-hidden="true">SA</span>Italy, Serie A</div>
                <h1 class="hero-title">Serie A Standings</h1>
                <p class="hero-subtitle">
                    @if (Model.CurrentWeek > 0)
                    {
                        @:Current table after matchweek @Model.CurrentWeek, with goal difference and recent form.
                    }
                    else
                    {
                        @:The season has not started yet. The table fills in as matches are completed.
                    }
                </p>
            </div>
            <dl class="hero-meta">
                <div><dt>Season</dt><dd>2026/27</dd></div>
                <div><dt>Matchweek</dt><dd>@Model.CurrentWeek</dd></div>
                <div><dt>Teams</dt><dd>@teamCount</dd></div>
            </dl>
        </div>

        <!-- Points ladder: the component draws .ladder-scroll and .ladder-track itself -->
        <section class="points-ladder" aria-labelledby="ladder-title">
            <div class="ladder-head">
                <h2 class="ladder-title" id="ladder-title">Points spread</h2>
                <p class="ladder-hint">Tap a team to find it in the table</p>
            </div>
            @await Component.InvokeAsync("_StandingRankComponent", new { model = Model })
        </section>
    </header>

    <!-- ===== Summary cards ===== -->
    <section class="summary-section" aria-label="Season highlights">
        <div class="row g-3">
            @foreach (var card in Model.StatCards)
            {
                <div class="col-sm-6 col-xl-3">
                    <partial name="_StatCard" model="card" />
                </div>
            }
        </div>
    </section>

    <div class="standings-body">
        <div class="row g-4">
            <div class="col-xl-9">

                <!-- ===== Table ===== -->
                <section class="table-panel" aria-labelledby="table-title">
                    <div class="table-toolbar">
                        <h2 class="table-toolbar__title" id="table-title">Overall standings</h2>
                        <div class="table-toolbar__controls">
                            <div class="zone-filter" role="group" aria-label="Filter by zone">
                                <button type="button" class="zone-chip zone-chip--all" data-zone-filter="all" aria-pressed="true">All</button>
                                <button type="button" class="zone-chip zone-chip--ucl" data-zone-filter="ucl" aria-pressed="false">Champions League</button>
                                <button type="button" class="zone-chip zone-chip--europe" data-zone-filter="europe" aria-pressed="false">Europe</button>
                                <button type="button" class="zone-chip zone-chip--rel" data-zone-filter="rel" aria-pressed="false">Relegation</button>
                            </div>
                            <label class="team-search">
                                <span class="visually-hidden">Search team</span>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4-4" /></svg>
                                <input type="search" id="team-search" placeholder="Search team" autocomplete="off" data-team-search>
                            </label>
                        </div>
                    </div>

                    <div class="standings-table-wrap">
                        <table class="standings-table">
                            <thead>
                                <tr>
                                    <th scope="col" class="col-pos">#</th>
                                    <th scope="col" class="col-team">Team</th>
                                    <th scope="col" class="col-num"><abbr title="Played">P</abbr></th>
                                    <th scope="col" class="col-num"><abbr title="Won">W</abbr></th>
                                    <th scope="col" class="col-num"><abbr title="Drawn">D</abbr></th>
                                    <th scope="col" class="col-num"><abbr title="Lost">L</abbr></th>
                                    <th scope="col" class="col-num col-hide-sm"><abbr title="Goals for">GF</abbr></th>
                                    <th scope="col" class="col-num col-hide-sm"><abbr title="Goals against">GA</abbr></th>
                                    <th scope="col" class="col-gd"><abbr title="Goal difference">GD</abbr></th>
                                    <th scope="col" class="col-pts">Pts</th>
                                    <th scope="col" class="col-form">Last 5</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in Model.Standings)
                                {
                                    <partial name="_StandingsRow" model="team" />
                                }
                                <tr class="empty-row" data-empty-row hidden>
                                    <td colspan="11">
                                        <strong>No teams found</strong>
                                        Try a different name or filter.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="table-foot">
                        <span>Showing <strong data-visible-count>@teamCount</strong> / @teamCount teams</span>
                        <span>Only completed matches count towards the table</span>
                    </div>
                </section>
            </div>

            <!-- ===== Sidebar ===== -->
            <aside class="col-xl-3" aria-label="Table notes">
                <div class="side-stack">
                    <section class="side-card">
                        <h2 class="side-card__title">Key</h2>
                        <ul class="legend-list">
                            <li><span class="legend-swatch" style="--swatch:var(--blue)"></span><div><strong>Champions League</strong><span>Positions 1-4</span></div></li>
                            <li><span class="legend-swatch" style="--swatch:var(--green)"></span><div><strong>European competitions</strong><span>Positions 5-6</span></div></li>
                            <li><span class="legend-swatch" style="--swatch:var(--red)"></span><div><strong>Relegation</strong><span>Positions 18-20</span></div></li>
                        </ul>
                        <ul class="form-key" aria-label="Form badges">
                            <li><span class="form-badge form-badge--w">W</span>Win</li>
                            <li><span class="form-badge form-badge--d">D</span>Draw</li>
                            <li><span class="form-badge form-badge--l">L</span>Loss</li>
                        </ul>
                    </section>

                    <section class="side-card">
                        <h2 class="side-card__title">In form</h2>
                        <p>Points from the last 5 matches</p>

                        @if (Model.InForm.Count == 0)
                        {
                            <p>No matches played yet.</p>
                        }
                        else
                        {
                            <ol class="form-leaders">
                                @foreach (var team in Model.InForm)
                                {
                                    <li>
                                        <partial name="_TeamBadge" model="team.TeamName" />
                                        <span class="team-name">@team.TeamName</span>
                                        <span class="form-leaders__pts">@team.FormPoints <small>/ @team.FormMaxPoints</small></span>
                                        <span class="form-meter" aria-hidden="true">
                                            <span style="--w:@(team.FormPoints * 100 / team.FormMaxPoints)%"></span>
                                        </span>
                                    </li>
                                }
                            </ol>
                        }
                    </section>

                    <section class="side-card note-card">
                        <h2 class="side-card__title">How the table is ranked</h2>
                        <p>Teams are ranked by points, then goal difference, then goals scored, then alphabetically.</p>
                        <p>In the form column, the rightmost badge is the most recent match.</p>
                    </section>
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* Standings: zone filter, team search, row selection and
           ladder <-> table linking. Rows and ladder markers are
           matched by data-team-id. */
        (function () {
            'use strict';

            const root = document.querySelector('[data-standings]');
            if (!root) return;

            const rows = Array.from(root.querySelectorAll('.standings-row'));
            const markers = Array.from(root.querySelectorAll('.ladder-marker'));
            const chips = Array.from(root.querySelectorAll('[data-zone-filter]'));
            const search = root.querySelector('[data-team-search]');
            const counter = root.querySelector('[data-visible-count]');
            const emptyRow = root.querySelector('[data-empty-row]');
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            let activeZone = 'all';
            let selectedTeam = null;

            // English locale on purpose: Turkish lower-casing turns "I" into "ı",
            // so "inter" would never match "Inter".
            const normalize = (value) =>
                (value || '').toLocaleLowerCase('en').normalize('NFD').replace(/[̀-ͯ]/g, '');

            /* Filtering --------------------------------------------- */
            function applyFilters() {
                const query = normalize(search ? search.value.trim() : '');
                let visible = 0;

                rows.forEach((row) => {
                    const zoneMatch = activeZone === 'all' || row.dataset.zone === activeZone;
                    const textMatch = !query || normalize(row.dataset.team).includes(query);
                    row.hidden = !(zoneMatch && textMatch);
                    if (!row.hidden) visible += 1;
                });

                if (counter) counter.textContent = String(visible);
                if (emptyRow) emptyRow.hidden = visible !== 0;
            }

            function setZone(zone) {
                activeZone = zone;
                chips.forEach((chip) =>
                    chip.setAttribute('aria-pressed', String(chip.dataset.zoneFilter === zone)));
                applyFilters();
            }

            function resetFilters() {
                if (search) search.value = '';
                setZone('all');
            }

            chips.forEach((chip) => chip.addEventListener('click', () => setZone(chip.dataset.zoneFilter)));
            if (search) search.addEventListener('input', applyFilters);

            /* Selection --------------------------------------------- */
            function selectTeam(teamId, { scrollToRow = false } = {}) {
                selectedTeam = selectedTeam === teamId ? null : teamId;

                rows.forEach((row) => row.classList.toggle('is-selected', row.dataset.teamId === selectedTeam));
                markers.forEach((marker) => {
                    const on = marker.dataset.teamId === selectedTeam;
                    marker.classList.toggle('is-active', on);
                    marker.setAttribute('aria-pressed', String(on));
                });

                if (!scrollToRow || !selectedTeam) return;
                const row = rows.find((r) => r.dataset.teamId === selectedTeam);
                if (!row) return;
                if (row.hidden) resetFilters();
                row.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
            }

            rows.forEach((row) => {
                row.addEventListener('click', () => selectTeam(row.dataset.teamId));
                row.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        selectTeam(row.dataset.teamId);
                    }
                });
            });

            markers.forEach((marker) =>
                marker.addEventListener('click', () => selectTeam(marker.dataset.teamId, { scrollToRow: true })));

            /* Hover linking: table row <-> ladder marker ------------ */
            function linkHover(teamId, on) {
                rows.forEach((r) => { if (r.dataset.teamId === teamId) r.classList.toggle('is-hover', on); });
                markers.forEach((m) => { if (m.dataset.teamId === teamId) m.classList.toggle('is-hover', on); });
            }

            rows.forEach((row) => {
                row.addEventListener('mouseenter', () => linkHover(row.dataset.teamId, true));
                row.addEventListener('mouseleave', () => linkHover(row.dataset.teamId, false));
            });
            markers.forEach((marker) => {
                marker.addEventListener('mouseenter', () => linkHover(marker.dataset.teamId, true));
                marker.addEventListener('mouseleave', () => linkHover(marker.dataset.teamId, false));
            });

            applyFilters();
        })();
    </script>
}
