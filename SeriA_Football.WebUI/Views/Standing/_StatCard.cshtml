@model StatCardViewModel

    <article class="stat-card stat-card--@Model.Variant">
        <div class="stat-card__icon">
            @switch (Model.Variant)
            {
                case "leader":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4h8v5a4 4 0 0 1-8 0V4z" /><path d="M8 6H5v1a3 3 0 0 0 3 3M16 6h3v1a3 3 0 0 1-3 3M12 13v4M9 20h6" /></svg>
                    break;
                case "attack":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.6l3.3 2.4-1.3 3.8h-4l-1.3-3.8z" /></svg>
                    break;
                case "defence":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" /></svg>
                    break;
                case "danger":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7l6 6 4-4 6 6M20 10v5h-5" /></svg>
                    break;
            }
        </div>
        <div class="stat-card__body">
            <p class="stat-card__label">@Model.Label</p>
            @if (Model.TeamName != null)
            {
                <p class="stat-card__team">
                    <partial name="_TeamBadge" model="Model.TeamName" />
                    @Model.TeamName
                </p>
            }
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <p class="stat-card__note">@Model.Note</p>
            }
        </div>
        <p class="stat-card__value">@Model.Value<small>@Model.Unit</small></p>
    </article>



