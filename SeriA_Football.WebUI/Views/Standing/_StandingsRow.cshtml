@model StandingViewModel
@{
    string gdClass = Model.GoalDifference > 0 ? "is-pos" : Model.GoalDifference < 0 ? "is-neg" : "is-zero";
    string gdText = Model.GoalDifference > 0 ? $"+{Model.GoalDifference}" : Model.GoalDifference.ToString();

    string FormLabel(string f) => f == "W" ? "Win" : f == "D" ? "Draw" : "Loss";
    string formAria = Model.Form.Count == 0
        ? "No matches played"
        : "Last matches, oldest to newest: " + string.Join(", ", Model.Form.Select(FormLabel));
}

<tr class="@Model.RowCss"
    data-zone="@Model.Zone"
    data-team="@Model.TeamName.ToLowerInvariant()"
    data-team-id="@Model.TeamId"
    tabindex="0">
    <td class="col-pos">@Model.Rank</td>
    <th scope="row" class="col-team">
        <div class="team-cell">
            <partial name="_TeamBadge" model="Model.TeamName" />
            <span class="team-name">@Model.TeamName</span>
        </div>
    </th>
    <td class="col-num">@Model.Played</td>
    <td class="col-num">@Model.Won</td>
    <td class="col-num">@Model.Drawn</td>
    <td class="col-num">@Model.Lost</td>
    <td class="col-num col-hide-sm">@Model.GoalsFor</td>
    <td class="col-num col-hide-sm">@Model.GoalsAgainst</td>
    <td class="col-gd"><span class="gd @gdClass">@gdText</span></td>
    <td class="col-pts">@Model.Points</td>
    <td class="col-form">
        <ol class="form-list" aria-label="@formAria">
            @foreach (var f in Model.Form)
            {
                <li><span class="form-badge form-badge--@f.ToLowerInvariant()" title="@FormLabel(f)">@f</span></li>
              
            }
            @for (int i = Model.Form.Count; i < 5; i++)
            {
                <li><span class="form-badge form-badge--empty" title="Not played yet"></span></li>
            }
        </ol>
    </td>
</tr>