@model FixturePageViewModel
@{
    ViewData["Title"] = "Fixture";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var en = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
}

    <main class="fixtures-shell container-xl" data-fixtures-page data-current-week="12">

        <!-- ===== Partial: _FixturesHero ===== -->
        <header class="fixtures-hero">
            <div class="hero-league">
                <span class="hero-league__name"><span class="league-mark" aria-hidden="true">SA</span>İtalya, Serie A</span>
                <label class="season-select">
                    <span class="visually-hidden">Sezon</span>
                    <select aria-label="Sezon seç">
                        <option selected>2026/27</option>
                    </select>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                </label>
            </div>
            <div class="hero-row">
                <div>
                    <h1 class="hero-title">Serie A Fikstür</h1>
                    <p class="hero-subtitle">Haftayı seç, o haftanın tüm maçlarını gün gün, skor ve durum bilgisiyle gör.</p>
                </div>
                <dl class="hero-meta">
                    <div><dt>Takım</dt><dd>20</dd></div>
                    <div><dt>Hafta</dt><dd>@Model.Week.ToString().Count()</dd></div>
                    <div><dt>Güncel hafta</dt><dd>@Model.Week</dd></div>
                </dl>
            </div>
        </header>

        <!-- ===== Partial: _WeekSelector ===== -->
        <partial name="_WeekSelector" model="Model" />

        <!-- ===== Partial: _WeekInfo ===== -->
    <partial name="_WeekInfo" model="Model" />

        <div class="fixtures-body">
            <div class="row g-4">
                <div class="col-lg-8">
                    <!-- ===== Haftanın maçları  ===== -->
                <section class="panel" aria-labelledby="fixtures-title">
                    <div class="panel__head">
                        <h2 class="panel__title" id="fixtures-title">This week's matches</h2>
                        <span class="panel__sub">Local kick-off times</span>
                    </div>

                    <div class="fixtures-list">
                        @if (Model.TotalMatches == 0)
                        {
                            <p class="page-note">No fixtures have been added for this week yet.</p>
                        }

                        @foreach (var day in Model.MatchesByDay)
                        {
                            var dayLabel = day.Key.ToString("dddd d MMMM", en);
                            var count = day.Count();

                            <section class="day-group" aria-label="@dayLabel">
                                <div class="day-head">
                                    <h3 class="day-head__date">@dayLabel</h3>
                                    <span class="day-head__count">@count @(count == 1 ? "match" : "matches")</span>
                                </div>
                                <ul class="day-list">
                                    @foreach (var match in day)
                                    {
                                        <partial name="_FixtureCard" model="match" />
                                    }
                                </ul>
                            </section>
                        }
                    </div>
                </section>
                </div>

                <aside class="col-lg-4" aria-label="Haftanın özeti ve öne çıkan maç">
                    <div class="side-stack">
                        <!-- ===== Partial: _WeeklySummary ===== -->
                        <section class="panel" aria-labelledby="summary-title" >
                        <partial name="_WeeklySummary" model="Model" />
                        </section>
                        <!-- ===== Partial: _FeaturedMatch ===== -->
                        <section class="panel featured" aria-labelledby="featured-title" >
                        <partial name="_FeaturedMatch" model="Model.FeaturedMatch" />
                        </section>
                    </div>
                </aside>
            </div>
        </div>

    </main>




