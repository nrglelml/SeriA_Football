@model int

<dialog class="modal-a modal-a--sm" id="delete-modal" aria-labelledby="delete-modal-title">
    <form method="post" asp-area="Admin" asp-controller="Matches" asp-action="Delete">
        <input type="hidden" name="id" data-delete-id>
        <input type="hidden" name="week" value="@Model">

        <div class="modal-head">
            <h2 class="modal-title" id="delete-modal-title">Maçı sil</h2>
            <button type="button" class="icon-btn" data-modal-close aria-label="Kapat">
                <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
            </button>
        </div>

        <div class="modal-body">
            <p class="confirm-text" data-delete-text></p>
        </div>

        <div class="modal-foot">
            <button type="button" class="btn-a btn-a--secondary" data-modal-close>Vazgeç</button>
            <button type="submit" class="btn-a btn-a--danger">Evet, sil</button>
        </div>
    </form>
</dialog>
